{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-knowledge-assistant.local/schema/lexical-baseline.schema.json",
  "title": "Code Knowledge Assistant lexical retrieval baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run", "sources", "scenarios", "summary"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run": {
      "type": "object",
      "required": ["id", "created_at", "retriever", "chunking", "provider_calls", "cost_usd", "content_execution"],
      "properties": {
        "provider_calls": { "const": 0 },
        "cost_usd": { "const": 0 },
        "content_execution": { "const": false }
      }
    },
    "sources": { "type": "array", "minItems": 1 },
    "scenarios": { "type": "array", "minItems": 1 },
    "summary": {
      "type": "object",
      "required": ["scenario_count", "retrieval_recall_at_10", "by_repository"],
      "properties": {
        "scenario_count": { "type": "integer", "minimum": 1 },
        "retrieval_recall_at_10": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
